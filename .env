# ===========================
# Gateway Basic Settings
# ===========================
GATEWAY_PORT=8000
DEFAULT_RATE_LIMIT_PER_MIN=120

# ===========================
# Authentication
# ===========================
# Comma-separated API keys for demo (DO NOT use in production without rotation)
API_KEYS=devkey123,anotherkey

# JWT settings
JWT_SECRET=changeme   # Replace in production
JWT_ALGORITHM=HS256

# ===========================
# Caching / Data Store
# ===========================
# Redis connection string
REDIS_URL=redis://localhost:6379/0

# ===========================
# Environment
# ===========================
ENVIRONMENT=development
